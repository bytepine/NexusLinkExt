{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "0.0.0",
	"FriendlyName": "NexusLinkExt",
	"Description": "NexusLink capabilities for optional plugins. Runtime module NexusLinkExt, editor module NexusLinkExtEditor. UnLua capabilities live here.",
	"Category": "Other",
	"CreatedBy": "byteyang",
	"CreatedByURL": "https://github.com/bytepine",
	"DocsURL": "https://github.com/bytepine/NexusLinkExt/blob/master/README.en.md",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/bytepine/NexusLinkExt/issues",
	"EngineVersion": "4.26",
	"CanContainContent": true,
	"IsBetaVersion": true,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "NexusLinkExt",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [ "Win64", "Mac" ],
			"WhitelistPlatforms": [ "Win64", "Mac" ]
		},
		{
			"Name": "NexusLinkExtEditor",
			"Type": "Editor",
			"LoadingPhase": "Default",
			"PlatformAllowList": [ "Win64", "Mac" ],
			"WhitelistPlatforms": [ "Win64", "Mac" ]
		}
	],
	"Plugins": [
		{
			"Name": "NexusLink",
			"Enabled": true
		},
		{
			"Name": "UnLua",
			"Enabled": false,
			"Optional": true
		}
	]
}